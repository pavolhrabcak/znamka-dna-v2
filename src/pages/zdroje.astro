---
import Base from '../layouts/Base.astro';
---

<Base
  title="Zdroje a literatúra"
  description="Zdroje a literatúra — aukčné domy, filatelistické spoločnosti a webové stránky, z ktorých čerpá encyklopédia britských koloniálnych poštových známok."
>
  <article data-pagefind-body class="max-w-5xl mx-auto px-8 md:px-12 pt-7 pb-16">

    <nav class="text-[10px] tracking-widest uppercase text-cream-400 mb-4 flex gap-2 items-center">
      <a href="/" class="hover:text-cream-900 transition-colors">Domov</a>
      <span>/</span>
      <span class="text-cream-600">Zdroje</span>
    </nav>

    <!-- Hero -->
    <div class="mb-10 pb-8 border-b border-cream-200">
      <h1 class="font-serif text-4xl md:text-5xl font-normal text-cream-900 mb-3">Zdroje a literatúra</h1>
      <div class="stamp-prose mt-6">
        <p>Táto webová stránka čerpá z nasledujúcich zdrojov. Uvedený zoznam bude priebežne dopĺňaný.</p>
      </div>
    </div>

    <!-- Aukčné domy -->
    <div class="mb-10 pb-10 border-b border-cream-200">
      <h2 class="font-serif text-2xl font-normal text-cream-900 mb-6">Aukčné domy a obchodníci</h2>
      <ul class="space-y-3">
        <li class="flex flex-col sm:flex-row sm:items-baseline gap-x-4">
          <span class="font-medium text-cream-900 text-sm min-w-[200px]">Stanley Gibbons</span>
          <a href="https://shop.stanleygibbons.com/" target="_blank" rel="noopener" class="text-sm text-cream-500 hover:text-cream-900 transition-colors break-all">https://shop.stanleygibbons.com/</a>
        </li>
        <li class="flex flex-col sm:flex-row sm:items-baseline gap-x-4">
          <span class="font-medium text-cream-900 text-sm min-w-[200px]">Spink</span>
          <a href="https://www.spink.com/" target="_blank" rel="noopener" class="text-sm text-cream-500 hover:text-cream-900 transition-colors break-all">https://www.spink.com/</a>
        </li>
        <li class="flex flex-col sm:flex-row sm:items-baseline gap-x-4">
          <span class="font-medium text-cream-900 text-sm min-w-[200px]">Cherrystone</span>
          <a href="https://www.cherrystoneauctions.com/" target="_blank" rel="noopener" class="text-sm text-cream-500 hover:text-cream-900 transition-colors break-all">https://www.cherrystoneauctions.com/</a>
        </li>
        <li class="flex flex-col sm:flex-row sm:items-baseline gap-x-4">
          <span class="font-medium text-cream-900 text-sm min-w-[200px]">eBay, British Colony &amp; Territory Stamps</span>
          <a href="https://www.ebay.co.uk/b/bn_1838441" target="_blank" rel="noopener" class="text-sm text-cream-500 hover:text-cream-900 transition-colors break-all">https://www.ebay.co.uk/b/bn_1838441</a>
        </li>
      </ul>
    </div>

    <!-- Filatelistické spoločnosti -->
    <div class="mb-10 pb-10 border-b border-cream-200">
      <h2 class="font-serif text-2xl font-normal text-cream-900 mb-6">Filatelistické spoločnosti a štúdijné kruhy</h2>
      <ul class="space-y-3">
        <li class="flex flex-col sm:flex-row sm:items-baseline gap-x-4">
          <span class="font-medium text-cream-900 text-sm min-w-[200px]">King George VI Collectors' Society</span>
          <a href="https://www.kg6.info/" target="_blank" rel="noopener" class="text-sm text-cream-500 hover:text-cream-900 transition-colors break-all">https://www.kg6.info/</a>
        </li>
        <li class="flex flex-col sm:flex-row sm:items-baseline gap-x-4">
          <span class="font-medium text-cream-900 text-sm min-w-[200px]">Borneo Philatelic Society</span>
          <a href="https://b-p-s.org.uk/" target="_blank" rel="noopener" class="text-sm text-cream-500 hover:text-cream-900 transition-colors break-all">https://b-p-s.org.uk/</a>
        </li>
        <li class="flex flex-col sm:flex-row sm:items-baseline gap-x-4">
          <span class="font-medium text-cream-900 text-sm min-w-[200px]">Rhodesian Study Circle</span>
          <a href="https://www.rhodesianstudycircle.org.uk/" target="_blank" rel="noopener" class="text-sm text-cream-500 hover:text-cream-900 transition-colors break-all">https://www.rhodesianstudycircle.org.uk/</a>
        </li>
        <li class="flex flex-col sm:flex-row sm:items-baseline gap-x-4">
          <span class="font-medium text-cream-900 text-sm min-w-[200px]">Bechuanaland Philately</span>
          <a href="https://www.bechuanalandphilately.com/" target="_blank" rel="noopener" class="text-sm text-cream-500 hover:text-cream-900 transition-colors break-all">https://www.bechuanalandphilately.com/</a>
        </li>
        <li class="flex flex-col sm:flex-row sm:items-baseline gap-x-4">
          <span class="font-medium text-cream-900 text-sm min-w-[200px]">The Rochester Philatelic Association</span>
          <a href="http://www.rpastamps.org/" target="_blank" rel="noopener" class="text-sm text-cream-500 hover:text-cream-900 transition-colors break-all">http://www.rpastamps.org/</a>
        </li>
      </ul>
    </div>

    <!-- Online katalógy -->
    <div class="mb-10 pb-10 border-b border-cream-200">
      <h2 class="font-serif text-2xl font-normal text-cream-900 mb-6">Online katalógy</h2>
      <ul class="space-y-3">
        <li class="flex flex-col sm:flex-row sm:items-baseline gap-x-4">
          <span class="font-medium text-cream-900 text-sm min-w-[200px]">Colnect</span>
          <a href="https://colnect.com/en/stamps" target="_blank" rel="noopener" class="text-sm text-cream-500 hover:text-cream-900 transition-colors break-all">https://colnect.com/en/stamps</a>
        </li>
      </ul>
    </div>

    <!-- Webové stránky a blogy -->
    <div class="mb-12">
      <h2 class="font-serif text-2xl font-normal text-cream-900 mb-6">Špecializované webové stránky a blogy</h2>
      <ul class="space-y-3">
        <li class="flex flex-col sm:flex-row sm:items-baseline gap-x-4">
          <span class="font-medium text-cream-900 text-sm min-w-[200px]">KGVI Stamps</span>
          <a href="http://www.kgvistamps.com/KGVIStamps-Collection.html" target="_blank" rel="noopener" class="text-sm text-cream-500 hover:text-cream-900 transition-colors break-all">http://www.kgvistamps.com/KGVIStamps-Collection.html</a>
        </li>
        <li class="flex flex-col sm:flex-row sm:items-baseline gap-x-4">
          <span class="font-medium text-cream-900 text-sm min-w-[200px]">My North Borneo Stamps</span>
          <a href="https://mynorthborneostamps.blogspot.com/" target="_blank" rel="noopener" class="text-sm text-cream-500 hover:text-cream-900 transition-colors break-all">https://mynorthborneostamps.blogspot.com/</a>
        </li>
        <li class="flex flex-col sm:flex-row sm:items-baseline gap-x-4">
          <span class="font-medium text-cream-900 text-sm min-w-[200px]">South Africa Collector</span>
          <a href="https://www.southafricacollector.com/" target="_blank" rel="noopener" class="text-sm text-cream-500 hover:text-cream-900 transition-colors break-all">https://www.southafricacollector.com/</a>
        </li>
        <li class="flex flex-col sm:flex-row sm:items-baseline gap-x-4">
          <span class="font-medium text-cream-900 text-sm min-w-[200px]">Stamp World History</span>
          <a href="https://stampworldhistory.nl/" target="_blank" rel="noopener" class="text-sm text-cream-500 hover:text-cream-900 transition-colors break-all">https://stampworldhistory.nl/</a>
        </li>
      </ul>
    </div>

    <div class="mt-14 pt-8 border-t border-cream-200 flex flex-wrap gap-3">
      <a href="/" class="inline-block border border-cream-900 text-cream-900 text-[11px] tracking-widest uppercase px-6 py-3 hover:bg-cream-900 hover:text-white transition-colors">
        ← Domov
      </a>
    </div>

  </article>
</Base>
