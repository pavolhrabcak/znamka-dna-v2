---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allStamps = await getCollection('stamps', s => !s.data.draft);

// Group by country with count
const countryMap = new Map();
allStamps.forEach(s => {
  const c = s.data.country;
  if (!countryMap.has(c)) countryMap.set(c, { country: c, region: s.data.region, count: 0 });
  countryMap.get(c).count++;
});
const countries = [...countryMap.values()].sort((a, b) => a.country.localeCompare(b.country));
---

<Base title="Krajiny">
  <section class="max-w-5xl mx-auto px-8 md:px-12 pt-14 pb-16">
    <div class="mb-10">
      <p class="text-[10px] tracking-widest uppercase text-cream-400 mb-2">Prehliadanie</p>
      <h1 class="font-serif text-3xl font-normal text-cream-900">Podľa krajiny</h1>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-px bg-cream-200">
      {countries.map(({ country, region, count }) => (
        <a
          href={`/krajiny/${country.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
          class="bg-cream-50 p-6 hover:bg-white transition-colors group"
        >
          <p class="font-serif text-base font-normal text-cream-900 group-hover:text-cream-700 transition-colors mb-1">{country}</p>
          {region && <p class="text-[10px] tracking-widest uppercase text-cream-400 mb-2">{region}</p>}
          <p class="text-[11px] text-cream-500">{count} {count === 1 ? 'známka' : count < 5 ? 'známky' : 'známok'}</p>
        </a>
      ))}
    </div>
  </section>
</Base>
