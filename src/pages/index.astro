---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allTerritories = await getCollection('territories', t => !t.data.draft);
const stampCount = allTerritories.reduce((sum, t) => sum + t.data.stamps.length, 0);
---

<Base title="Britské kolónie — Gravírované poštové známky" description="Malá encyklopédia gravírovaných poštových známok britského impéria. Teritóriá, tlačiarne, éry KGV, KGVI a QEII — hĺbkotlačové emisie britských kolónií na jednom mieste.">
  <section class="max-w-5xl mx-auto px-8 md:px-12 pt-14 pb-16">

    <!-- Hero -->
    <div class="mb-14">
      <h1 class="font-serif text-4xl md:text-5xl font-normal text-cream-900 mb-3">Britské kolónie</h1>
      <p class="font-serif text-xl md:text-2xl font-normal text-cream-600 italic mb-6">Malá encyklopédia gravírovaných poštových známok britského impéria</p>
      <div class="stamp-prose">
        <p>Napriek tomu, že Británia začala získavať kolónie až o sto rokov neskôr ako Španielsko, v nasledujúcich rokoch svoje zaostávanie vyrovnala a v koloniálnej politike neskôr predstihla všetky ostatné európske veľmoci.</p>
        <p>Desaťročia pred prvou svetovou vojnou bola Británia veľmocou s najväčším územím. V období jej vrcholného rozmachu k nej patrila takmer štvrtina celej zemegule a riadila životy vyše 400 miliónov ľudí. V tomto období Británia v rozličnej miere ovplyvňovala všetky svetadiely. Neskôr, na imperiálnej výstave v roku 1926, bolo koloniálne panstvo prezentované ako impérium, nad ktorým nezapadá slnko.</p>
        <p>Pre Britov bolo dôležité, aby na rozličných miestach sveta vybudovali strategické oporné body (napr. Gibraltar, Ascension, Singapur, Aden, Cyprus), ktoré mali strážiť námorné trasy a obchodné prístavy. Tieto prístavy im často slúžili ako odrazové mostíky ku kolonizácii vnútrozemia.Aj mimoriadny význam Indie — „perly britskej koruny" — nútil kontrolovať Britániu všetky trasy vedúce z Indie k Britským ostrovom.</p>
        <p>Británia rozširovala a upevňovala svoje koloniálne výdobytky aj z prestíže a tiež preto, aby územie nezískal niekto iný. Rozširovaním svojho koloniálneho impéria získavala mimoriadny vplyv na svetové dianie.</p>
        <p>
        Túto globálnu dominanciu a kultúrne sebavedomie Británia hrdo demonštrovala prostredníctvom koloniálnych poštových známok. Najmä v prvej polovici 20. storočia ustúpili strohé dizajny vizuálne úchvatným obrazovým emisiám (tzv. pictorials). Tieto miniatúrne umelecké diela, bohato ilustrované detailnými rytinami lokálnych scenérií a fauny, boli realizované tou najušľachtilejšou a najnákladnejšou polygrafickou technikou tej éry – oceľovou hĺbkotlačou.
        </p>
      </div>
    </div>

    <!-- Action section -->
    <div class="mb-10 border-y border-cream-200 py-8">

      <p class="font-serif text-2xl md:text-3xl font-normal text-cream-800 mb-7 leading-snug">
        Preskúmajte Britské impérium<br class="hidden md:block"/> prostredníctvom poštových známok tlačených z hĺbky (Intaglio)
      </p>

      <!-- Stats -->
      <div class="flex flex-wrap items-baseline gap-x-7 gap-y-2 mb-8">
        <div>
          <span class="font-serif text-3xl text-cream-900">{allTerritories.length}</span>
          <span class="text-[10px] tracking-widest uppercase text-cream-400 ml-1.5">teritórií</span>
        </div>
        <span class="text-cream-300 hidden sm:inline">·</span>
        <div>
          <span class="font-serif text-3xl text-cream-900">{stampCount}</span>
          <span class="text-[10px] tracking-widest uppercase text-cream-400 ml-1.5">detailov známok</span>
        </div>
        <span class="text-cream-300 hidden sm:inline">·</span>
        <span class="text-[11px] tracking-widest uppercase text-cream-600">KGV · KGVI · QEII</span>
        <span class="text-cream-300 hidden sm:inline">·</span>
        <span class="text-[11px] tracking-widest uppercase text-cream-600">Recess printing</span>
      </div>

      <!-- CTAs -->
      <div class="flex flex-wrap gap-3">
        <a href="/territories" class="bg-cream-900 text-white text-[11px] tracking-widest uppercase px-6 py-3 hover:bg-cream-800 transition-colors">
          Preskúmať teritóriá
        </a>
        <a href="/era/kgv"  class="border border-amber-200  bg-amber-50  text-amber-700  text-[11px] tracking-widest uppercase px-5 py-3 hover:border-amber-400  transition-colors">KGV</a>
        <a href="/era/kgvi" class="border border-blue-200   bg-blue-50   text-blue-700   text-[11px] tracking-widest uppercase px-5 py-3 hover:border-blue-400   transition-colors">KGVI</a>
        <a href="/era/qeii" class="border border-violet-200 bg-violet-50 text-violet-700 text-[11px] tracking-widest uppercase px-5 py-3 hover:border-violet-400 transition-colors">QEII</a>
        <a href="/printer/waterlow-and-sons"  class="border border-cream-300 text-cream-700 text-[11px] tracking-widest uppercase px-5 py-3 hover:border-cream-700 hover:text-cream-900 transition-colors">Waterlow</a>
        <a href="/printer/de-la-rue"          class="border border-cream-300 text-cream-700 text-[11px] tracking-widest uppercase px-5 py-3 hover:border-cream-700 hover:text-cream-900 transition-colors">De La Rue</a>
        <a href="/printer/bradbury-wilkinson" class="border border-cream-300 text-cream-700 text-[11px] tracking-widest uppercase px-5 py-3 hover:border-cream-700 hover:text-cream-900 transition-colors">Bradbury</a>
      </div>

    </div>

    <!-- British Empire map — single clickable area to /territories -->
    <a href="/territories" class="block group relative overflow-hidden border border-cream-200 hover:border-cream-400 transition-colors duration-300">
      <img
        src="/stamps/The_British_Empire.png"
        alt="Mapa Britského impéria"
        class="w-full block transition-transform duration-500 group-hover:scale-[1.04]"
      />
      <div class="absolute inset-0 flex items-end justify-end p-4 pointer-events-none">
        <span class="text-white text-[10px] tracking-widest uppercase px-3 py-1.5 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
          Preskúmať všetky kolónie →
        </span>
      </div>
    </a>

  </section>
</Base>
