---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allStamps = await getCollection('stamps', s => !s.data.draft);

const printerMap = new Map();
allStamps.forEach(s => {
  const p = s.data.printer;
  if (!printerMap.has(p)) printerMap.set(p, { printer: p, count: 0 });
  printerMap.get(p).count++;
});
const printers = [...printerMap.values()].sort((a, b) => b.count - a.count);
---

<Base title="Tlačiarne">
  <section class="max-w-5xl mx-auto px-8 md:px-12 pt-14 pb-16">
    <div class="mb-10">
      <p class="text-[10px] tracking-widest uppercase text-cream-400 mb-2">Prehliadanie</p>
      <h1 class="font-serif text-3xl font-normal text-cream-900">Podľa tlačiarne</h1>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-cream-200">
      {printers.map(({ printer, count }) => (
        <a
          href={`/tlaciarene/${printer.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
          class="bg-cream-50 p-6 hover:bg-white transition-colors group flex items-center justify-between"
        >
          <div>
            <p class="font-serif text-base font-normal text-cream-900 group-hover:text-cream-700 transition-colors">{printer}</p>
            <p class="text-[11px] text-cream-500 mt-1">{count} {count === 1 ? 'známka' : count < 5 ? 'známky' : 'známok'}</p>
          </div>
          <span class="text-cream-300 group-hover:text-cream-600 transition-colors text-xl">→</span>
        </a>
      ))}
    </div>
  </section>
</Base>
