---
import Base from '../layouts/Base.astro';
---

<style>
  .tabs-ready .tab-panel { display: none; }
  .tabs-ready .tab-panel.tab-active { display: block; }
</style>

<Base
  title="Glosár — Technické pojmy hĺbkotlače"
  description="Slovník technických pojmov súvisiacich s hĺbkotlačou (recess printing) britských koloniálnych poštových známok. Rytecká technológia, anatómia hárku, papier a atrament, výrobné chyby."
>
  <article data-pagefind-body class="max-w-5xl mx-auto px-8 md:px-12 pt-7 pb-16">

    <nav class="text-[10px] tracking-widest uppercase text-cream-400 mb-4 flex gap-2 items-center">
      <a href="/" class="hover:text-cream-900 transition-colors">Domov</a>
      <span>/</span>
      <span class="text-cream-600">Glosár</span>
    </nav>

    <!-- Hero -->
    <div class="mb-8 pb-8 border-b border-cream-200">
      <h1 class="font-serif text-4xl md:text-5xl font-normal text-cream-900 mb-3">Glosár</h1>
      <p class="font-serif text-xl md:text-2xl font-normal text-cream-600 italic">
        Technické pojmy ryteckej a tlačiarenskej praxe britských koloniálnych emisií
      </p>
    </div>

    <!-- Tab bar -->
    <div class="flex flex-wrap gap-x-8 gap-y-0 border-b border-cream-200 mb-10">
      <button class="tab-btn pb-2.5 -mb-px text-[11px] tracking-widest uppercase border-b-2 text-cream-900 border-cream-800 transition-colors" data-target="tlac">Technológia tlače</button>
      <button class="tab-btn pb-2.5 -mb-px text-[11px] tracking-widest uppercase border-b-2 text-cream-400 border-transparent hover:text-cream-700 transition-colors" data-target="arch">Dizajn a hárok</button>
      <button class="tab-btn pb-2.5 -mb-px text-[11px] tracking-widest uppercase border-b-2 text-cream-400 border-transparent hover:text-cream-700 transition-colors" data-target="material">Papier &amp; Atrament</button>
      <button class="tab-btn pb-2.5 -mb-px text-[11px] tracking-widest uppercase border-b-2 text-cream-400 border-transparent hover:text-cream-700 transition-colors" data-target="chyby">Variety &amp; Chyby</button>
      <button class="tab-btn pb-2.5 -mb-px text-[11px] tracking-widest uppercase border-b-2 text-cream-400 border-transparent hover:text-cream-700 transition-colors" data-target="stav">Stav známky</button>
    </div>

    <!-- Panel 1: Printing & Production -->
    <div data-tab="tlac" class="tab-panel tab-active">
      <div class="mb-8">
        <p class="text-[10px] tracking-widest uppercase text-cream-400 mb-1">1</p>
        <h2 id="tab-tlac" class="font-serif text-2xl font-normal text-cream-900">Technológia a fázy tlače</h2>
        <p class="text-[11px] tracking-widest uppercase text-cream-500 mt-1">Printing &amp; Production</p>
      </div>

      <div class="space-y-7">
        <div id="term-colour-trial" class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-x-8 gap-y-1">
          <div>
            <h3 class="font-serif text-[1.1rem] leading-[1.8] font-semibold text-cream-900 m-0">Colour Trial</h3>
            <p class="text-[11px] tracking-widest uppercase text-cream-600 mt-0.5 mb-0">Farebná skúška</p>
          </div>
          <div class="stamp-prose">
            Skúšobný nátlačok finálnej platne v rôznych farbách, ktorý tlačiareň predkladala Korunným agentom (Crown Agents) na schválenie finálneho odtieňa pred spustením produkcie. Tieto vzácne kusy sú filatelistami mimoriadne cenené.
          </div>
        </div>

        <div id="term-die" class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-x-8 gap-y-1">
          <div>
            <h3 class="font-serif text-[1.1rem] leading-[1.8] font-semibold text-cream-900 m-0">Die</h3>
            <p class="text-[11px] tracking-widest uppercase text-cream-600 mt-0.5 mb-0">Matica / Pôvodná raznica</p>
          </div>
          <div class="stamp-prose">
            Malý kúsok mäkkej ocele, do ktorého rytec ručne vyryl pôvodný motív známky v prevrátenej podobe. Po zakalení slúži na prenos motívu na tlačovú platňu. Každá raznica je jedinečné umelecké dielo rytca.
          </div>
        </div>

        <div id="term-die-proof" class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-x-8 gap-y-1">
          <div>
            <h3 class="font-serif text-[1.1rem] leading-[1.8] font-semibold text-cream-900 m-0">Die Proof / Plate Proof</h3>
            <p class="text-[11px] tracking-widest uppercase text-cream-600 mt-0.5 mb-0">Skúšobný nátlačok z matice / z platne</p>
          </div>
          <div class="stamp-prose">
            Kontrolná tlač určená na overenie detailov rytiny pred spustením masovej produkcie. Die Proof pochádza priamo z pôvodnej matice, Plate Proof z hotovej tlačovej platne. Oba druhy slúžili ako archívna dokumentácia kvality rytiny.
          </div>
        </div>

        <div id="term-headplate" class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-x-8 gap-y-1">
          <div>
            <h3 class="font-serif text-[1.1rem] leading-[1.8] font-semibold text-cream-900 m-0">Headplate / Frameplate</h3>
            <p class="text-[11px] tracking-widest uppercase text-cream-600 mt-0.5 mb-0">Portrétna / Rámová platňa</p>
          </div>
          <div class="stamp-prose">
            Pri dvojfarebných známkach sa tlačilo z dvoch samostatných platní. Headplate obsahovala portrét monarchu, Frameplate ozdobný rám, názov kolónie a nominálnu hodnotu. Oba priechody cez lis museli byť dokonale registrované.
          </div>
        </div>

        <div id="term-key-plate" class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-x-8 gap-y-1">
          <div>
            <h3 class="font-serif text-[1.1rem] leading-[1.8] font-semibold text-cream-900 m-0">Key Plate</h3>
            <p class="text-[11px] tracking-widest uppercase text-cream-600 mt-0.5 mb-0">Kľúčová / Hlavná tlačová platňa</p>
          </div>
          <div class="stamp-prose">
            Skutočná fyzická kovová platňa, ktorá tlačila masový, unifikovaný rám a portrét panovníka pre desiatky rôznych kolónií v dvojfázovom procese tlače. Arch papiera išiel do lisu dvakrát: najprv z univerzálnej Key Plate a následne z malej, špecifickej a lacnej Duty Plate (Nápisovej/Menovitej platne), ktorá dotlačila názov konkrétnej kolónie a hodnotu. Hoci bol tento postup doménou typografie, výnimočne sa uplatnil aj pri luxusnej veľkoformátovej hĺbkotlači (recess). De La Rue takto vytlačila vysoké hodnoty (2s až £1) pre kolónie ako Bermudy, Nyasaland či Leeward Islands za vlády Juraja VI. Išlo o technologicky náročnú dvojplatňovú hĺbkotlač, kde jedna platňa niesla univerzálny rám s portrétom kráľa a druhá texty pre danú kolóniu, čo dnes filatelisti študujú kvôli vzácnym posunom sútlače a odtieňom atramentu.
          </div>
        </div>

        <div id="term-master-die" class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-x-8 gap-y-1">
          <div>
            <h3 class="font-serif text-[1.1rem] leading-[1.8] font-semibold text-cream-900 m-0">Master Die</h3>
            <p class="text-[11px] tracking-widest uppercase text-cream-600 mt-0.5 mb-0">Hlavná matica</p>
          </div>
          <div class="stamp-prose">
            Raznica obsahujúca spoločné prvky (napr. portrét panovníka), z ktorej sa odvodzovali platne pre rôzne kolónie alebo hodnoty. Jedna hlavná matica mohla slúžiť ako základ pre emisie desiatok rôznych území Britského impéria.
          </div>
        </div>

        <div id="term-recess-printing" class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-x-8 gap-y-1">
          <div>
            <h3 class="font-serif text-[1.1rem] leading-[1.8] font-semibold text-cream-900 m-0">Recess Printing / Intaglio</h3>
            <p class="text-[11px] tracking-widest uppercase text-cream-600 mt-0.5 mb-0">Hĺbkotlač / Oceľotlač</p>
          </div>
          <div class="stamp-prose">
            Tlačová technika, pri ktorej je motív vyrytý pod úroveň tlačovej platne. Farba sa vtláča do rýh a pod obrovským tlakom sa prenáša na papier, čo vytvára typický hmatateľný reliéf na povrchu vytlačenej známky.
          </div>
        </div>
      </div>
    </div>

    <!-- Panel 2: Sheet Anatomy -->
    <div data-tab="arch" class="tab-panel">
      <div class="mb-8">
        <p class="text-[10px] tracking-widest uppercase text-cream-400 mb-1">2</p>
        <h2 id="tab-arch" class="font-serif text-2xl font-normal text-cream-900">Anatómia hárku, okraje a dizajn známok</h2>
        <p class="text-[11px] tracking-widest uppercase text-cream-500 mt-1">Sheet Anatomy, Controls &amp; Design</p>
      </div>

      <div class="space-y-7">
        <div id="term-imprint" class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-x-8 gap-y-1">
          <div>
            <h3 class="font-serif text-[1.1rem] leading-[1.8] font-semibold text-cream-900 m-0">Imprint</h3>
            <p class="text-[11px] tracking-widest uppercase text-cream-600 mt-0.5 mb-0">Tlačiarenská značka</p>
          </div>
          <div class="stamp-prose">
            Text na okraji archu identifikujúci firmu, ktorá imprint (tlačiarenský nápis) vytlačila (napr. <em>Thomas De La Rue &amp; Co. Ltd.</em>). Kľúčový prvok pri určovaní tlačiarní a pri rozlišovaní dotlačí po fúzii Waterlow &amp; Sons a De La Rue v roku 1961.
          </div>
        </div>

        <div id="term-key-type" class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-x-8 gap-y-1">
          <div>
            <h3 class="font-serif text-[1.1rem] leading-[1.8] font-semibold text-cream-900 m-0">Key Type</h3>
            <p class="text-[11px] tracking-widest uppercase text-cream-600 mt-0.5 mb-0">Jednotný vizuálny typ / Dizajnový koncept</p>
          </div>
          <div class="stamp-prose">
            Označuje štandardizovanú grafickú šablónu (predlohu) známky, ktorú londýnske tlačiarne (najmä De La Rue) zdieľali naprieč viacerými úplne odlišnými kolóniami s cieľom ušetriť náklady na dizajn. Vytvoril sa spoločný rám s prázdnymi miestami („tablety"), do ktorých sa neskôr vkladal názov konkrétnej krajiny a hodnota. Typickým príkladom sú slávne spoločné koloniálne emisie (Omnibus Issues), ako dizajn „Imperium", prípadne série k Striebornému jubileu (1935) či Korunovácii (1937). Pozor: Tento koncept bol viazaný takmer výlučne na tlač z výšky (kníhtlač / typografiu), ktorá technicky umožňovala jednoduchú výmenu textových častí. Lokálne emisie, ktoré opakovane používali ten istý národný motív naprieč vládami viacerých panovníkov (napr. séria „Baobab a dobytok" pre Bečuánsko), sa nepovažujú za Key Type, ale za dlhotrvajúce obrazové definitívy, pretože boli pre každého panovníka rytecky vytvorené na mieru odznova.
          </div>
        </div>

        <div id="term-omnibus" class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-x-8 gap-y-1">
          <div>
            <h3 class="font-serif text-[1.1rem] leading-[1.8] font-semibold text-cream-900 m-0">Omnibus</h3>
            <p class="text-[11px] tracking-widest uppercase text-cream-600 mt-0.5 mb-0">Spoločná emisia / Omnibus Issue</p>
          </div>
          <div class="stamp-prose">
            <p>Súborné filatelistické označenie pre sériu poštových známok, ktoré vydalo viacero samostatných kolónií alebo štátov s rovnakým grafickým dizajnom, jednotným motívom a k rovnakému historickému výročiu. Účelom bolo šetriť náklady na prípravu rytín a demonštrovať imperiálnu jednotu. V britskom impériu rozlišujeme dva typy omnibusov:</p>
            <ul class="mt-2 space-y-1.5 list-disc pl-5">
              <li><strong>Globálne (Všeobecné):</strong> Distribuované do všetkých kolónií pod správou Crown Agents. Najznámejšími príkladmi sú emisie k Striebornému jubileu Juraja V. (1935), Korunovácii Juraja VI. (1937), Víťazstvu v druhej svetovej vojne (1946) alebo Korunovácii Alžbety II. (1953).</li>
              <li><strong>Regionálne:</strong> Obmedzené len na určitú geografickú oblasť. Učebnicovým príkladom z éry kráľa Juraja VI. je hĺbkotlačová emisia z roku 1951 k inaugurácii University College of the West Indies, ktorú paralelne vydalo 14 karibských území vrátane Leeward Islands, Barbadosu či Jamajky so zhodným motívom univerzitného znaku.</li>
            </ul>
          </div>
        </div>

        <div id="term-pictorials" class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-x-8 gap-y-1">
          <div>
            <h3 class="font-serif text-[1.1rem] leading-[1.8] font-semibold text-cream-900 m-0">Pictorials</h3>
            <p class="text-[11px] tracking-widest uppercase text-cream-600 mt-0.5 mb-0">Obrazové / Krajinné známky</p>
          </div>
          <div class="stamp-prose">
            Označenie pre poštové známky, ktorých hlavným vizuálnym motívom už nie je len strohý portrét panovníka alebo štátny znak, ale detailné vyobrazenie lokálnej krajiny, fauny, flóry, historických udalostí alebo priemyslu. V prostredí britských kolónií zažili masový rozmach v 30. až 50. rokoch 20. storočia (najmä za vlád Juraja VI. a Alžbety II.). Pre zberateľov sú tieto emisie vizuálne najatraktívnejšie, pričom britskí Korunní agenti (Crown Agents) ich tlač realizovali takmer výlučne formou luxusnej a detailnej hĺbkotlače (recess printing), aby podporili turizmus a lokálnu hrdosť jednotlivých kolónií.
          </div>
        </div>

        <div id="term-plate-number" class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-x-8 gap-y-1">
          <div>
            <h3 class="font-serif text-[1.1rem] leading-[1.8] font-semibold text-cream-900 m-0">Plate Number</h3>
            <p class="text-[11px] tracking-widest uppercase text-cream-600 mt-0.5 mb-0">Číslo platne</p>
          </div>
          <div class="stamp-prose">
            Číslo (alebo písmeno) vyryté na okraji archu, ktoré označuje konkrétnu tlačovú platňu použitú na produkciu. Umožňuje sledovať životný cyklus jednotlivých platní a identifikovať odlišnosti medzi rôznymi tlačami toho istého vydania.
          </div>
        </div>

        <div id="term-selvedge" class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-x-8 gap-y-1">
          <div>
            <h3 class="font-serif text-[1.1rem] leading-[1.8] font-semibold text-cream-900 m-0">Selvedge / Margin</h3>
            <p class="text-[11px] tracking-widest uppercase text-cream-600 mt-0.5 mb-0">Okraj archu</p>
          </div>
          <div class="stamp-prose">
            Nepotlačený biely pás papiera lemujúci hárky známok, kde sa nachádzali imprinty, čísla platní, kontrolné značky či zúbkovanie strán. Zachovanie celého okraja (Imprint Block) výrazne zvyšuje hodnotu filatelistickej položky.
          </div>
        </div>

        <div id="term-vignette" class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-x-8 gap-y-1">
          <div>
            <h3 class="font-serif text-[1.1rem] leading-[1.8] font-semibold text-cream-900 m-0">Vignette</h3>
            <p class="text-[11px] tracking-widest uppercase text-cream-600 mt-0.5 mb-0">Vineta / Stredový motív</p>
          </div>
          <div class="stamp-prose">
            Ústredný obraz známky — krajina, loď, zviera, budova — zvyčajne umiestnený v strede rámu a pri dvojfarebných emisiách tlačený odlišnou farbou ako rám. Práve vineta určuje tematický a zberateľský charakter celej série.
          </div>
        </div>
      </div>
    </div>

    <!-- Panel 3: Paper, Ink & Gum -->
    <div data-tab="material" class="tab-panel">
      <div class="mb-8">
        <p class="text-[10px] tracking-widest uppercase text-cream-400 mb-1">3</p>
        <h2 id="tab-material" class="font-serif text-2xl font-normal text-cream-900">Materiály a chémia</h2>
        <p class="text-[11px] tracking-widest uppercase text-cream-500 mt-1">Paper, Ink &amp; Gum</p>
      </div>

      <div class="space-y-7">
        <div id="term-chalky-paper" class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-x-8 gap-y-1">
          <div>
            <h3 class="font-serif text-[1.1rem] leading-[1.8] font-semibold text-cream-900 m-0">Chalky Paper</h3>
            <p class="text-[11px] tracking-widest uppercase text-cream-600 mt-0.5 mb-0">Kriedový papier</p>
          </div>
          <div class="stamp-prose">
            Papier potiahnutý jemnou vrstvou kriedového roztoku. Pri hĺbkotlači zabezpečoval mimoriadne ostrú kresbu detailov rytiny a slúžil aj ako ochrana — pri pokuse o zmývanie pečiatky sa kriedový povlak poškodí a strhne spolu s časťou obrazu.
          </div>
        </div>

        <div id="term-fugitive-ink" class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-x-8 gap-y-1">
          <div>
            <h3 class="font-serif text-[1.1rem] leading-[1.8] font-semibold text-cream-900 m-0">Fugitive Ink</h3>
            <p class="text-[11px] tracking-widest uppercase text-cream-600 mt-0.5 mb-0">Prchavý / Bezpečnostný atrament</p>
          </div>
          <div class="stamp-prose">
            Špeciálny atrament citlivý na vodu alebo chemikálie, používaný ako ochrana proti falšovaniu a opätovnému použitiu známok (zmývaniu pečiatok). Pri pokuse o chemické čistenie sa farba rozpustí alebo rozmaže, čo okamžite odhalí manipuláciu.
          </div>
        </div>

        <div id="term-crown-ca" class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-x-8 gap-y-1">
          <div>
            <h3 class="font-serif text-[1.1rem] leading-[1.8] font-semibold text-cream-900 m-0">Multiple Script CA / Multiple Crown CA</h3>
            <p class="text-[11px] tracking-widest uppercase text-cream-600 mt-0.5 mb-0">Koloniálny vodoznak</p>
          </div>
          <div class="stamp-prose">
            Typické názvy koloniálnych vodoznakov Crown Agents (CA), podľa ktorých sa určuje epocha emisie a jej platnosť. <em>Multiple Crown CA</em> bol používaný do cca 1952, <em>Multiple Script CA</em> v neskoršom období. Správne určenie vodoznaku je kľúčové pre katalogizáciu.
          </div>
        </div>

        <div id="term-ordinary-paper" class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-x-8 gap-y-1">
          <div>
            <h3 class="font-serif text-[1.1rem] leading-[1.8] font-semibold text-cream-900 m-0">Ordinary Paper</h3>
            <p class="text-[11px] tracking-widest uppercase text-cream-600 mt-0.5 mb-0">Obyčajný papier</p>
          </div>
          <div class="stamp-prose">
            Bežný papier bez kriedovej vrstvy, používaný najmä pri skorších alebo vojnových emisiách z dôvodu šetrenia materiálom a dostupnosti. Vo všeobecnosti menej odolný voči pokusom o zmývanie pečiatok ako kriedový papier.
          </div>
        </div>

        <div id="term-tropical-gum" class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-x-8 gap-y-1">
          <div>
            <h3 class="font-serif text-[1.1rem] leading-[1.8] font-semibold text-cream-900 m-0">Tropical Gum</h3>
            <p class="text-[11px] tracking-widest uppercase text-cream-600 mt-0.5 mb-0">Tropický lep</p>
          </div>
          <div class="stamp-prose">
            Špeciálne zloženie lepu (často tmavšieho alebo matnejšieho odtieňa), ktoré tlačiarne nanášali na známky určené pre horúce a vlhké kolónie v Karibiku a Afrike. Zabraňovalo zlepeniu archov ešte v skladoch pred distribúciou.
          </div>
        </div>
      </div>
    </div>

    <!-- Panel 4: Flaws & Varieties -->
    <div data-tab="chyby" class="tab-panel">
      <div class="mb-8">
        <p class="text-[10px] tracking-widest uppercase text-cream-400 mb-1">4</p>
        <h2 id="tab-chyby" class="font-serif text-2xl font-normal text-cream-900">Výrobné chyby a variety</h2>
        <p class="text-[11px] tracking-widest uppercase text-cream-500 mt-1">Flaws &amp; Varieties</p>
      </div>

      <div class="space-y-7">
        <div id="term-blued-paper" class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-x-8 gap-y-1">
          <div>
            <h3 class="font-serif text-[1.1rem] leading-[1.8] font-semibold text-cream-900 m-0">Blued Paper / Blueing</h3>
            <p class="text-[11px] tracking-widest uppercase text-cream-600 mt-0.5 mb-0">Modranie papiera</p>
          </div>
          <div class="stamp-prose">
            Fenomén, kedy chemická reakcia medzi určitými druhmi prchavých atramantov a papierom (alebo nedostatočné zotretie farby z platne) spôsobila, že papier nadobudol modrastý nádych. Modranlivý papier výrazne mení vzhľad hodnoty a vytvára zberateľsky zaujímavú varietitu.
          </div>
        </div>

        <div id="term-inverted-vignette" class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-x-8 gap-y-1">
          <div>
            <h3 class="font-serif text-[1.1rem] leading-[1.8] font-semibold text-cream-900 m-0">Inverted Vignette</h3>
            <p class="text-[11px] tracking-widest uppercase text-cream-600 mt-0.5 mb-0">Obrátený stred</p>
          </div>
          <div class="stamp-prose">
            Slávna chyba sútlače pri dvojfarebných známkach, kedy bol arch do tlačového lisu vložený opačne a stredový motív (loď, portrét) je voči rámu hore nohami. Patrí medzi najžiadanejšie a najvzácnejšie omyly v celej klasickej filatelii.
          </div>
        </div>

        <div id="term-plate-flaw" class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-x-8 gap-y-1">
          <div>
            <h3 class="font-serif text-[1.1rem] leading-[1.8] font-semibold text-cream-900 m-0">Plate Flaw / Constant Flaw</h3>
            <p class="text-[11px] tracking-widest uppercase text-cream-600 mt-0.5 mb-0">Dosková chyba / Trvalá chyba</p>
          </div>
          <div class="stamp-prose">
            Chyba v obraze (škrabanec, vryp, chýbajúca línia), ktorá vznikla poškodením tlačovej platne. Opakuje sa na rovnakom mieste v každom vytlačenom archu, kým nedošlo k oprave platne. Platňové chyby slúžia na identifikáciu konkrétnych platní a tlačiarenských epocht.
          </div>
        </div>

        <div id="term-re-entry" class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-x-8 gap-y-1">
          <div>
            <h3 class="font-serif text-[1.1rem] leading-[1.8] font-semibold text-cream-900 m-0">Re-entry</h3>
            <p class="text-[11px] tracking-widest uppercase text-cream-600 mt-0.5 mb-0">Dvojitá rytina / Opakovaný prenos</p>
          </div>
          <div class="stamp-prose">
            Technická chyba pri výrobe platne, kedy bol motív z raznice vtlačený do platne dvakrát na mierne posunutom mieste. Na hotovej známke sa to prejavuje zdvojenými alebo zosilnenými líniami rytiny, typicky v rohoch alebo v okrajovom ráme.
          </div>
        </div>

        <div id="term-shade" class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-x-8 gap-y-1">
          <div>
            <h3 class="font-serif text-[1.1rem] leading-[1.8] font-semibold text-cream-900 m-0">Shade</h3>
            <p class="text-[11px] tracking-widest uppercase text-cream-600 mt-0.5 mb-0">Farebný odtieň</p>
          </div>
          <div class="stamp-prose">
            Jemná odchýlka v tóne alebo sýtosti základnej farby známky. V ére koloniálnej hĺbkotlače De La Rue vznikali odtiene primárne kvôli vojnovým a povojnovým dotlačiam. Tlačiareň miešala nové várky atramantov ručne, čo pri rovnakom nominále viedlo k vzniku odtieňov (napr. od jasnomodrej po indigo). Na intenzitu odtieňa mal vplyv aj tlak lisu a hĺbka vrypu platne. Pre špecialistov sú odtiene kľúčom k určeniu presného roku tlače.
          </div>
        </div>

        <div id="term-specimen" class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-x-8 gap-y-1">
          <div>
            <h3 class="font-serif text-[1.1rem] leading-[1.8] font-semibold text-cream-900 m-0">Specimen</h3>
            <p class="text-[11px] tracking-widest uppercase text-cream-600 mt-0.5 mb-0">Vzorka</p>
          </div>
          <div class="stamp-prose">
            Známka pretlačená alebo perforovaná nápisom <em>SPECIMEN</em>. Tieto kusy boli zasielané Svetovej poštovej únii (UPU) a slúžili ako vzory pre poštové správy po celom svete. Nemali poštovú platnosť, čo z ich zberu robí samostatnú a veľmi populárnu špecializáciu.
          </div>
        </div>

        <div id="term-variety" class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-x-8 gap-y-1">
          <div>
            <h3 class="font-serif text-[1.1rem] leading-[1.8] font-semibold text-cream-900 m-0">Variety</h3>
            <p class="text-[11px] tracking-widest uppercase text-cream-600 mt-0.5 mb-0">Variety / Varianty</p>
          </div>
          <div class="stamp-prose">
            <p>Súborné označenie pre akékoľvek zámerné alebo nezámerné odchýlky od štandardného (základného) vydania známky. Vo filatelii britských kolónií špecialisti najčastejšie študujú tri typy variet:</p>
            <ul class="mt-2 space-y-1.5 list-disc pl-5">
              <li><strong>Perforačné:</strong> Rozdiely v rozmeroch zúbkovania (napr. Perf 13.5 vs Perf 14) spôsobené použitím rôznych perforačných strojov pri dotlačiach.</li>
              <li><strong>Vodoznakové:</strong> Obrátené, stranovo prevrátené alebo úplne vynechané vodoznaky — chyby pri vkladaní papiera do lisu.</li>
              <li><strong>Farebné:</strong> Výrazné zmeny farieb (zámeny tlačových platní) alebo chýbajúce farby pri viacfarebnej hĺbkotlači.</li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- Panel 5: Condition & Grading -->
    <div data-tab="stav" class="tab-panel">
      <div class="mb-8">
        <p class="text-[10px] tracking-widest uppercase text-cream-400 mb-1">5</p>
        <h2 id="tab-stav" class="font-serif text-2xl font-normal text-cream-900">Medzinárodné skratky stavu známok</h2>
        <p class="text-[11px] tracking-widest uppercase text-cream-500 mt-1">Condition &amp; Grading</p>
      </div>
      <p class="stamp-prose mb-7">Tieto skratky určujú stav zachovania lepu a lícovej strany známky, čo je primárnym faktorom pri určovaní trhovej hodnoty.</p>

      <div class="space-y-7">
        <div id="term-mnh" class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-x-8 gap-y-1">
          <div>
            <h3 class="font-serif text-[1.1rem] leading-[1.8] font-semibold text-cream-900 m-0">MNH / UM</h3>
            <p class="text-[11px] tracking-widest uppercase text-cream-600 mt-0.5 mb-0">Mint Never Hinged / Unmounted Mint</p>
          </div>
          <div class="stamp-prose">
            Čistá, neopečiatkovaná známka s úplným, 100 % pôvodným lepom tak, ako opustila tlačiareň. Lep nesmie niesť žiadne stopy po filatelistickej nálepke, odtlačky prstov ani žiadne narušenie. Pri hĺbkotlačiach De La Rue z obdobia KGVI ide o zberateľsky najcennejší a najvyhľadávanejší stav.
          </div>
        </div>

        <div id="term-lhm" class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-x-8 gap-y-1">
          <div>
            <h3 class="font-serif text-[1.1rem] leading-[1.8] font-semibold text-cream-900 m-0">LHM / MLH</h3>
            <p class="text-[11px] tracking-widest uppercase text-cream-600 mt-0.5 mb-0">Lightly Hinged Mint</p>
          </div>
          <div class="stamp-prose">
            Podkategória stavu MH. Označuje známku, ktorá má len minimálnu, sotva viditeľnú stopu po nálepke a drvivá väčšina pôvodného lepu zostala čistá a neporušená. Na trhu má vyššiu hodnotu než bežné MH.
          </div>
        </div>

        <div id="term-mh" class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-x-8 gap-y-1">
          <div>
            <h3 class="font-serif text-[1.1rem] leading-[1.8] font-semibold text-cream-900 m-0">MH</h3>
            <p class="text-[11px] tracking-widest uppercase text-cream-600 mt-0.5 mb-0">Mint Hinged</p>
          </div>
          <div class="stamp-prose">
            Neopečiatkovaná známka, ktorá má na lepe buď priamo nalepenú filatelistickú nálepku (falcu), alebo nesie jasné stopy a pozostatky po jej odstránení (porušený lep).
          </div>
        </div>

        <div id="term-used" class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-x-8 gap-y-1">
          <div>
            <h3 class="font-serif text-[1.1rem] leading-[1.8] font-semibold text-cream-900 m-0">Used</h3>
            <p class="text-[11px] tracking-widest uppercase text-cream-600 mt-0.5 mb-0">Opečiatkovaná / Prešla poštou</p>
          </div>
          <div class="stamp-prose">
            Známka, ktorá splnila svoju poštovú funkciu a nesie odtlačok poštovej pečiatky (cancel / postmark). Pri koloniálnych hĺbkotlačiach sa preferujú čisté, čitateľné kruhové pečiatky (tzv. CDS — Circular Date Stamp), kde je vidieť dátum a názov mesta, čo zvyšuje historickú hodnotu.
          </div>
        </div>
      </div>
    </div>

    <div class="mt-14 pt-8 border-t border-cream-200">
      <a href="/" class="text-[11px] tracking-widest uppercase text-cream-500 hover:text-cream-900 transition-colors">
        ← Domov
      </a>
    </div>

  </article>

  <script>
    document.querySelector<HTMLElement>('article[data-pagefind-body]')?.classList.add('tabs-ready');

    function activateTab(target: string) {
      document.querySelectorAll<HTMLElement>('.tab-panel').forEach(p => p.classList.remove('tab-active'));
      document.querySelector<HTMLElement>('[data-tab="' + target + '"]')?.classList.add('tab-active');
      document.querySelectorAll<HTMLButtonElement>('.tab-btn').forEach(b => {
        const isActive = b.dataset.target === target;
        b.classList.toggle('text-cream-900', isActive);
        b.classList.toggle('border-cream-800', isActive);
        b.classList.toggle('text-cream-400', !isActive);
        b.classList.toggle('border-transparent', !isActive);
        b.classList.toggle('hover:text-cream-700', !isActive);
      });
    }

    function activateTabForHash(hash: string) {
      if (hash.startsWith('tab-')) {
        activateTab(hash.slice(4));
      } else if (hash.startsWith('term-')) {
        const termEl = document.getElementById(hash);
        if (termEl) {
          const panel = termEl.closest<HTMLElement>('[data-tab]');
          if (panel?.dataset.tab) {
            activateTab(panel.dataset.tab);
            requestAnimationFrame(() => termEl.scrollIntoView({ behavior: 'smooth', block: 'start' }));
          }
        }
      }
    }

    const initialHash = window.location.hash.slice(1);
    if (initialHash) activateTabForHash(initialHash);

    window.addEventListener('hashchange', () => {
      const hash = window.location.hash.slice(1);
      if (hash) activateTabForHash(hash);
    });

    document.querySelectorAll<HTMLButtonElement>('.tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.dataset.target!;
        activateTab(target);
        history.replaceState(null, '', '#tab-' + target);
      });
    });
  </script>
</Base>
