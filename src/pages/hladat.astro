---
import Base from '../layouts/Base.astro';
---

<Base title="Hľadať">
  <section class="max-w-3xl mx-auto px-8 md:px-12 pt-14 pb-16">
    <div class="mb-10">
      <p class="text-[10px] tracking-widest uppercase text-cream-400 mb-2">Fulltext</p>
      <h1 class="font-serif text-3xl font-normal text-cream-900">Hľadať</h1>
    </div>

    <div id="search"></div>
  </section>
</Base>

<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
<script src="/pagefind/pagefind-ui.js" is:inline></script>
<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    new PagefindUI({
      element: '#search',
      showSubResults: true,
      translations: {
        placeholder: 'Hľadať známky, krajiny, tlačiarne…',
        zero_results: 'Žiadne výsledky pre "[SEARCH_TERM]"',
      },
    });
  });
</script>
