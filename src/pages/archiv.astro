---
import Base from '../layouts/Base.astro';
import StampCard from '../components/StampCard.astro';
import { getCollection } from 'astro:content';

const allStamps = await getCollection('stamps', s => !s.data.draft);
allStamps.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Collect all unique tags, countries, printers
const allTags = [...new Set(allStamps.flatMap(s => s.data.tags))].sort();
const allCountries = [...new Set(allStamps.map(s => s.data.country))].sort();
const allPrinters = [...new Set(allStamps.map(s => s.data.printer))].sort();
---

<Base title="Archív">
  <section class="max-w-5xl mx-auto px-8 md:px-12 pt-14 pb-16">

    <div class="mb-10">
      <p class="text-[10px] tracking-widest uppercase text-cream-400 mb-2">Archív</p>
      <h1 class="font-serif text-3xl font-normal text-cream-900">Všetky známky</h1>
    </div>

    <!-- Filters (JS-powered) -->
    <div class="flex flex-wrap gap-3 mb-10 pb-8 border-b border-cream-200" id="filters">
      <div class="flex items-center gap-2">
        <label class="text-[10px] tracking-widest uppercase text-cream-400">Tag:</label>
        <select id="filter-tag" class="text-xs border border-cream-300 bg-white px-2 py-1 text-cream-700 focus:outline-none focus:border-cream-600">
          <option value="">Všetky</option>
          {allTags.map(t => <option value={t}>#{t}</option>)}
        </select>
      </div>
      <div class="flex items-center gap-2">
        <label class="text-[10px] tracking-widest uppercase text-cream-400">Krajina:</label>
        <select id="filter-country" class="text-xs border border-cream-300 bg-white px-2 py-1 text-cream-700 focus:outline-none focus:border-cream-600">
          <option value="">Všetky</option>
          {allCountries.map(c => <option value={c}>{c}</option>)}
        </select>
      </div>
      <div class="flex items-center gap-2">
        <label class="text-[10px] tracking-widest uppercase text-cream-400">Tlačiareň:</label>
        <select id="filter-printer" class="text-xs border border-cream-300 bg-white px-2 py-1 text-cream-700 focus:outline-none focus:border-cream-600">
          <option value="">Všetky</option>
          {allPrinters.map(p => <option value={p}>{p}</option>)}
        </select>
      </div>
      <button id="filter-reset" class="text-[10px] tracking-widest uppercase text-cream-400 hover:text-cream-900 transition-colors ml-2">
        Zrušiť filtre
      </button>
    </div>

    <!-- Grid -->
    <div id="stamp-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8">
      {allStamps.map(stamp => (
        <div
          class="stamp-item"
          data-tags={stamp.data.tags.join(',')}
          data-country={stamp.data.country}
          data-printer={stamp.data.printer}
        >
          <StampCard stamp={stamp} />
        </div>
      ))}
    </div>

    <p id="no-results" class="hidden text-center text-cream-400 font-serif italic text-lg py-16">
      Žiadne známky nevyhovujú filtrom.
    </p>

  </section>

  <script>
    const tagSel     = document.getElementById('filter-tag');
    const countrySel = document.getElementById('filter-country');
    const printerSel = document.getElementById('filter-printer');
    const resetBtn   = document.getElementById('filter-reset');
    const items      = document.querySelectorAll('.stamp-item');
    const noResults  = document.getElementById('no-results');

    // Pre-fill from URL ?tag=
    const params = new URLSearchParams(window.location.search);
    if (params.get('tag')) tagSel.value = params.get('tag');

    function applyFilters() {
      const tag     = tagSel.value;
      const country = countrySel.value;
      const printer = printerSel.value;
      let visible = 0;
      items.forEach(item => {
        const tags    = item.dataset.tags.split(',');
        const match   = (!tag || tags.includes(tag))
                     && (!country || item.dataset.country === country)
                     && (!printer || item.dataset.printer === printer);
        item.style.display = match ? '' : 'none';
        if (match) visible++;
      });
      noResults.classList.toggle('hidden', visible > 0);
    }

    tagSel.addEventListener('change', applyFilters);
    countrySel.addEventListener('change', applyFilters);
    printerSel.addEventListener('change', applyFilters);
    resetBtn.addEventListener('click', () => {
      tagSel.value = ''; countrySel.value = ''; printerSel.value = '';
      applyFilters();
    });

    applyFilters();
  </script>
</Base>
