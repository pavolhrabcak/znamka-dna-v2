---
import Base from '../layouts/Base.astro';
import { readdirSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection } from 'astro:content';
import { printerMap } from '../data/imprints-gallery';

const territories = await getCollection('territories');
const territoryNames = Object.fromEntries(territories.map(t => [t.slug, t.data.name]));

const ERA_MAP: Record<string, 'KGV' | 'KGVI' | 'QEII'> = {
  kgv: 'KGV', kgvi: 'KGVI', qeii: 'QEII', qe: 'QEII',
};

const validSlugs = new Set(territories.map(t => t.slug));

const imprintFiles = readdirSync(join(process.cwd(), 'public', 'imprints'))
  .filter(f => f.endsWith('.webp'))
  .sort();

const imprintGallery = imprintFiles.flatMap(filename => {
  const parts = filename.replace('.webp', '').split('-');
  const eraIdx = parts.findIndex(p => p in ERA_MAP);
  if (eraIdx < 1) return [];
  const territorySlug = parts.slice(0, eraIdx).join('-');
  const era = ERA_MAP[parts[eraIdx]];
  const year = parseInt(parts[eraIdx + 1]) || 0;
  const printerKey = parts.slice(eraIdx + 2).join('-');
  return [{
    image: `/imprints/${filename}`,
    territory: territoryNames[territorySlug] ?? territorySlug.split('-').map(w => w[0].toUpperCase() + w.slice(1)).join(' '),
    territorySlug,
    hasTerritory: validSlugs.has(territorySlug),
    printer: printerMap[printerKey] ?? printerKey,
    era,
    year,
  }];
});

const galleryPrinters = [...new Set(imprintGallery.map(i => i.printer))].sort();
const printerCounts = Object.fromEntries(galleryPrinters.map(p => [p, imprintGallery.filter(i => i.printer === p).length]));
---

<Base
  title="Imprinty — Tlačiarenské značky"
  description="Imprinty na okrajoch archov poštových známok: príbeh fúzie Waterlow & Sons a De La Rue cez prípadovú štúdiu Solomon Islands 3d Malaita Canoe."
>
  <article data-pagefind-body class="max-w-5xl mx-auto px-8 md:px-12 pt-7 pb-16">

    <nav class="text-[10px] tracking-widest uppercase text-cream-400 mb-4 flex gap-2 items-center">
      <a href="/" class="hover:text-cream-900 transition-colors">Domov</a>
      <span>/</span>
      <span class="text-cream-600">Imprinty</span>
    </nav>

    <!-- Hero -->
    <div class="mb-10 pb-8 border-b border-cream-200">
      <h1 class="font-serif text-4xl md:text-5xl font-normal text-cream-900 mb-3">Imprinty</h1>
      <p class="font-serif text-xl md:text-2xl font-normal text-cream-600 italic mb-7">
        Odvrátená strana archu: tlačiarenské značky a príbeh fúzie storočia
      </p>
      <div class="flex flex-wrap items-baseline gap-x-7 gap-y-2 mb-6">
        <span class="text-[11px] tracking-widest uppercase text-cream-600">Waterlow &amp; Sons</span>
        <span class="text-cream-300 hidden sm:inline">·</span>
        <span class="text-[11px] tracking-widest uppercase text-cream-600">De La Rue</span>
        <span class="text-cream-300 hidden sm:inline">·</span>
        <span class="text-[11px] tracking-widest uppercase text-cream-600">Imprint Blocks</span>
        <span class="text-cream-300 hidden sm:inline">·</span>
        <span class="text-[11px] tracking-widest uppercase text-cream-600">QEII</span>
      </div>
      <a href="#galeria" class="inline-block border border-cream-300 text-cream-700 text-[11px] tracking-widest uppercase px-5 py-3 hover:border-cream-900 hover:text-cream-900 transition-colors">
        Pozrieť galériu →
      </a>
    </div>

    <!-- Intro -->
    <div class="mb-10 pb-10 border-b border-cream-200">
      <div class="stamp-prose">
        <p>
          Pre bežného poštového zákazníka bola podstatná len samotná známka. Pre špecializovaného filatelistu sa však
          to najväčšie dobrodružstvo často začína až na bielom okraji známkového archu. Imprinty (tlačiarenské značky)
          sú identifikačné nápisy na okrajoch archov, ktorými si bezpečnostné tlačiarne označovali svoju produkciu.
          V histórii britských koloniálnych emisií tieto nenápadné texty odhaľujú dramatické zvraty na trhu
          s ceninami — vrátane konca éry tlačiarne Waterlow &amp; Sons.
        </p>
      </div>
    </div>

    <!-- Section 1 -->
    <div class="mb-10 pb-10 border-b border-cream-200">
      <h2 class="font-serif text-2xl font-normal text-cream-900 mb-5">Výkladná skriňa na okraji papiera</h2>
      <div class="stamp-prose">
        <p>
          Tlačiarne ako De La Rue, Waterlow &amp; Sons, Bradbury Wilkinson či Harrison &amp; Sons bojovali o prestížne
          kontrakty britských Korunných agentov (Crown Agents) desiatky rokov. Umiestnenie názvu firmy na spodný alebo
          horný okraj archu (zvyčajne v strede pod dolným radom známok) bolo nielen podmienkou zmlúv, ale aj identifikačným prvkom produkcie.
        </p>
        <p>
          Pre zberateľov špecializácií sú dnes tieto okrajové kusy, zachované v podobe pásov alebo štvorblokov,
          mimoriadne vyhľadávané — tzv. <strong>Imprint Blocks</strong> alebo <strong>Plate Blocks</strong>.
          Zachovať arch s celým okrajom v bezchybnom stave bolo vždy výnimočné, a preto tieto kusy dosahujú
          na aukciách niekoľkonásobne vyššie ceny ako bežné jednotlivé kusy.
        </p>
      </div>
    </div>

    <!-- Section 2 -->
    <div class="mb-10 pb-10 border-b border-cream-200">
      <h2 class="font-serif text-2xl font-normal text-cream-900 mb-5">Rok 1961: Keď matice zmenili majiteľa</h2>
      <div class="stamp-prose">
        <p>
          Keď v roku 1961 Thomas De La Rue (TDLR) pohltil finančne oslabeného rivala Waterlow &amp; Sons,
          nezískal len budovy a lisy, ale predovšetkým neoceniteľné duševné vlastníctvo. Do rúk De La Rue prešli
          tisíce originálnych hĺbkotlačových matíc a hotových tlačových platní pre desiatky britských kolónií.
        </p>
        <p>
          Keďže mnohé kolónie potrebovali dotlače svojich vtedy aktuálnych definitívnych sérií, De La Rue stála
          pred pragmatickým rozhodnutím: namiesto rytia nových platní použili tie pôvodné od Waterlow. Došlo však
          k zásadnej úprave — pôvodný okrajový nápis konkurenta musel zmiznúť. Robotníci na platniach mechanicky
          vybrúsili alebo prekryli starú značku a vyryli nový text: <strong>„THOMAS DE LA RUE &amp; COMPANY, LIMITED."</strong>
        </p>
      </div>
    </div>

    <!-- Section 3: Case study with images -->
    <div class="mb-10 pb-10 border-b border-cream-200">
      <h2 class="font-serif text-2xl font-normal text-cream-900 mb-5">Prípadová štúdia: 3d Malaita Canoe</h2>
      <p class="text-[11px] tracking-widest uppercase text-cream-400 mb-6">Britské Šalamúnove ostrovy · Séria QEII · 1956 / 1963</p>

      <!-- Images side by side -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        <div>
          <div class="border border-cream-200 bg-white p-4 mb-3 cursor-zoom-in hover:border-cream-500 hover:shadow-lg transition-all duration-200" onclick="openLightbox(0)">
            <img
              src="/stamps/solomon-1956-waterlow.webp"
              alt="Solomon Islands 1956 3d Malaita Canoe imprint block, Waterlow & Sons"
              class="w-full object-contain"
              loading="lazy"
            />
          </div>
          <p class="text-[11px] tracking-widest uppercase text-cream-600">Solomon Islands 1956</p>
          <p class="text-sm text-cream-500 mt-0.5">Imprint block · Waterlow &amp; Sons</p>
        </div>
        <div>
          <div class="border border-cream-200 bg-white p-4 mb-3 cursor-zoom-in hover:border-cream-500 hover:shadow-lg transition-all duration-200" onclick="openLightbox(1)">
            <img
              src="/stamps/solomon-1963-dlr.webp"
              alt="Solomon Islands 1963 3d Malaita Canoe imprint block, De La Rue"
              class="w-full object-contain"
              loading="lazy"
            />
          </div>
          <p class="text-[11px] tracking-widest uppercase text-cream-600">Solomon Islands 1963</p>
          <p class="text-sm text-cream-500 mt-0.5">Imprint block · Thomas De La Rue &amp; Company, Limited</p>
        </div>
      </div>

      <div class="stamp-prose">
        <p>
          Učebnicovým príkladom tohto prechodu je definitívna emisia Britských Šalamúnových ostrovov z roku 1956
          (séria QEII). Priložené fotografie ukazujú štvorblok s okrajom archu (imprint block) hodnoty 3d
          s motívom tradičného kanoe z ostrova Malaita.
        </p>
        <ul>
          <li>
            <strong>Pôvodná tlač (1956):</strong> Hodnotu 3d kompletne vyryla a vytlačila hĺbkotlačou firma
            Waterlow &amp; Sons. Na dolnom okraji archu sa nachádza ich typický nápis
            <em>„Waterlow &amp; Sons Limited, London Wall, London, E.C."</em>
          </li>
          <li>
            <strong>Dotlač De La Rue (po roku 1961):</strong> Keď zásoby známok na ostrovoch klesli, De La Rue
            vzala pôvodnú platňu Waterlow. Na spodnom okraji teraz dominuje nápis
            <em>„THOMAS DE LA RUE &amp; COMPANY, LIMITED."</em>
          </li>
        </ul>
        <p>
          Hoci samotný obraz známky, jemné detaily domorodcov v kanoe a portrét kráľovnej zostali na oboch
          verziách identické — keďže pochádzajú z rovnakej matice — imprint na okraji neomylne
          prezrádza skutočného pôvodcu tlače a historické obdobie vzniku.
        </p>
      </div>
    </div>

    <!-- Collector's tip -->
    <div class="mb-10 pb-10 border-b border-cream-200">
      <div class="border-l-2 border-cream-300 pl-6">
        <p class="text-[10px] tracking-widest uppercase text-cream-400 mb-3">Tip pre zberateľov</p>
        <div class="stamp-prose">
          <p>
            Ak nájdete známky z tejto éry bez okrajov, dotlače od De La Rue z rokov 1961–1965 sa dajú
            identifikovať aj podľa papiera. Waterlow používal v 50. rokoch o niečo mäkší, krémovejší papier.
            De La Rue naopak dotlač realizovala na čistejšom, žiarivo bielom papieri. Tieto rozdiely sú
            pri porovnaní oboch verzií pod lupou zreteľne viditeľné.
          </p>
        </div>
      </div>
    </div>

    <!-- Section 4: Gallery -->
    <div class="mb-10 pb-10 border-b border-cream-200">
      <h2 id="galeria" class="font-serif text-2xl font-normal text-cream-900 mb-2">Galéria imprintov</h2>
      <p class="text-sm text-cream-500 italic mb-6">Dokumentárne fotografie blokových kusov s tlačiarenskými značkami</p>

      {imprintGallery.length === 0 ? (
        <p class="text-sm text-cream-400 italic">Galéria bude čoskoro doplnená.</p>
      ) : (
        <div>
          {galleryPrinters.length > 1 && (
            <div class="flex flex-wrap gap-2 mb-6">
              <button data-filter="all" class="imprint-filter text-[11px] tracking-widest uppercase px-4 py-2 border border-cream-900 bg-cream-900 text-white transition-colors">Všetky ({imprintGallery.length})</button>
              {galleryPrinters.map(p => (
                <button data-filter={p} class="imprint-filter text-[11px] tracking-widest uppercase px-4 py-2 border border-cream-300 text-cream-700 hover:border-cream-700 hover:text-cream-900 transition-colors">{p} ({printerCounts[p]})</button>
              ))}
            </div>
          )}
          <div id="imprint-grid" class="grid grid-cols-2 md:grid-cols-3 gap-5">
            {imprintGallery.map((item, i) => (
              <div class="imprint-card flex flex-col" data-printer={item.printer}>
                <div
                  class="border border-cream-200 bg-white p-3 mb-2 cursor-zoom-in hover:border-cream-500 hover:shadow-lg transition-all duration-200"
                  onclick={`openGalleryLb(${i})`}
                >
                  <div class="aspect-[4/3] flex items-center justify-center overflow-hidden">
                    <img
                      src={item.image}
                      alt={`${item.territory} ${item.year} imprint block — ${item.printer}`}
                      class="w-full h-full object-contain"
                      loading="lazy"
                    />
                  </div>
                </div>
                {item.hasTerritory
                  ? <a href={`/territories/${item.territorySlug}`} class="text-[11px] tracking-widest uppercase text-cream-700 hover:text-cream-950 transition-colors hover:underline underline-offset-2">{item.territory}</a>
                  : <span class="text-[11px] tracking-widest uppercase text-cream-700">{item.territory}</span>
                }
                <p class="text-sm text-cream-500 mt-0.5">{item.series ? `${item.series} · ` : ''}{item.year}</p>
                <div class="mt-1 flex flex-wrap gap-1">
                  <span class="text-[9px] tracking-widest uppercase px-1.5 py-0.5 border border-cream-200 text-cream-400">{item.printer}</span>
                  {item.era === 'KGV'  && <span class="text-[9px] tracking-widest px-1.5 py-0.5 border bg-amber-50 text-amber-700 border-amber-200">KGV</span>}
                  {item.era === 'KGVI' && <span class="text-[9px] tracking-widest px-1.5 py-0.5 border bg-teal-50 text-teal-700 border-teal-200">KGVI</span>}
                  {item.era === 'QEII' && <span class="text-[9px] tracking-widest px-1.5 py-0.5 border bg-violet-50 text-violet-700 border-violet-200">QEII</span>}
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>

    <div class="mt-14 pt-8 border-t border-cream-200 flex flex-wrap gap-3">
      <a href="/" class="inline-block border border-cream-900 text-cream-900 text-[11px] tracking-widest uppercase px-6 py-3 hover:bg-cream-900 hover:text-white transition-colors">
        ← Domov
      </a>
      <a href="/printer/waterlow-and-sons" class="inline-block border border-cream-300 text-cream-700 text-[11px] tracking-widest uppercase px-6 py-3 hover:border-cream-900 hover:text-cream-900 transition-colors">
        Waterlow &amp; Sons →
      </a>
      <a href="/printer/de-la-rue" class="inline-block border border-cream-300 text-cream-700 text-[11px] tracking-widest uppercase px-6 py-3 hover:border-cream-900 hover:text-cream-900 transition-colors">
        De La Rue →
      </a>
    </div>

  </article>

  <!-- Lightbox -->
  <div id="lightbox" class="hidden fixed inset-0 bg-black/90 z-50 flex-col items-center justify-center px-8 py-3" onclick="closeLightbox()">
    <div class="w-full max-w-3xl flex items-center justify-between mb-2 flex-shrink-0" onclick="event.stopPropagation()">
      <span id="lightbox-counter" class="text-[11px] tracking-widest text-white/40"></span>
      <button onclick="closeLightbox()" class="text-white/60 hover:text-white text-2xl leading-none px-2 transition-colors">&#215;</button>
    </div>
    <div class="relative max-w-3xl w-full flex items-center" onclick="event.stopPropagation()">
      <button id="lightbox-prev" onclick="lightboxNav(-1)" class="absolute left-0 -translate-x-10 text-white/50 hover:text-white text-5xl leading-none px-2 py-6 transition-colors z-10">&#8249;</button>
      <button id="lightbox-next" onclick="lightboxNav(1)" class="absolute right-0 translate-x-10 text-white/50 hover:text-white text-5xl leading-none px-2 py-6 transition-colors z-10">&#8250;</button>
      <div class="w-full">
        <img id="lightbox-img" src="" alt="" class="w-full object-contain max-h-[calc(100vh-100px)]" />
        <p id="lightbox-caption" class="text-center text-[11px] tracking-widest uppercase text-white/40 mt-2"></p>
      </div>
    </div>
  </div>

  <script is:inline>
    var stampItems = [
      { src: '/stamps/solomon-1956-waterlow.webp', caption: 'Solomon Islands 1956 · Waterlow & Sons' },
      { src: '/stamps/solomon-1963-dlr.webp',      caption: 'Solomon Islands 1963 · Thomas De La Rue & Company, Limited' }
    ];
    var currentIndex = 0;

    function updateLightbox() {
      var item = stampItems[currentIndex];
      document.getElementById('lightbox-img').src = item.src;
      document.getElementById('lightbox-img').alt = item.caption;
      document.getElementById('lightbox-caption').textContent = item.caption;
      document.getElementById('lightbox-counter').textContent = (currentIndex + 1) + ' / ' + stampItems.length;
      document.getElementById('lightbox-prev').style.visibility = currentIndex === 0 ? 'hidden' : 'visible';
      document.getElementById('lightbox-next').style.visibility = currentIndex === stampItems.length - 1 ? 'hidden' : 'visible';
    }

    window.openLightbox = function(index) {
      currentIndex = index;
      updateLightbox();
      var lb = document.getElementById('lightbox');
      lb.classList.remove('hidden');
      lb.classList.add('flex', 'flex-col');
      document.body.style.overflow = 'hidden';
    };

    window.lightboxNav = function(dir) {
      var next = currentIndex + dir;
      if (next >= 0 && next < stampItems.length) {
        currentIndex = next;
        updateLightbox();
      }
    };

    window.closeLightbox = function() {
      var lb = document.getElementById('lightbox');
      lb.classList.add('hidden');
      lb.classList.remove('flex', 'flex-col');
      document.body.style.overflow = '';
    };

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') window.closeLightbox();
      if (e.key === 'ArrowLeft') window.lightboxNav(-1);
      if (e.key === 'ArrowRight') window.lightboxNav(1);
    });
  </script>

  <!-- Gallery lightbox -->
  <div id="gallery-lightbox" class="hidden fixed inset-0 bg-black/90 z-50 flex-col items-center justify-center px-8 py-3" onclick="closeGalleryLb()">
    <div class="w-full max-w-3xl flex items-center justify-between mb-2 flex-shrink-0" onclick="event.stopPropagation()">
      <span id="gallery-lb-counter" class="text-[11px] tracking-widest text-white/40"></span>
      <button onclick="closeGalleryLb()" class="text-white/60 hover:text-white text-2xl leading-none px-2 transition-colors">&#215;</button>
    </div>
    <div class="relative max-w-3xl w-full flex items-center" onclick="event.stopPropagation()">
      <button id="gallery-lb-prev" onclick="galleryLbNav(-1)" class="absolute left-0 -translate-x-10 text-white/50 hover:text-white text-5xl leading-none px-2 py-6 transition-colors z-10">&#8249;</button>
      <button id="gallery-lb-next" onclick="galleryLbNav(1)" class="absolute right-0 translate-x-10 text-white/50 hover:text-white text-5xl leading-none px-2 py-6 transition-colors z-10">&#8250;</button>
      <div class="w-full">
        <img id="gallery-lb-img" src="" alt="" class="w-full object-contain max-h-[calc(100vh-100px)]" />
        <p id="gallery-lb-caption" class="text-center text-[11px] tracking-widest uppercase text-white/40 mt-2"></p>
      </div>
    </div>
  </div>

  <script define:vars={{ galleryItems: imprintGallery.map(i => ({ src: i.image, caption: `${i.territory} · ${i.printer} · ${i.year}`, printer: i.printer })) }}>
    var galIdx = 0;
    var activeGalleryItems = galleryItems.slice();

    function updateGalleryLb() {
      var item = activeGalleryItems[galIdx];
      document.getElementById('gallery-lb-img').src = item.src;
      document.getElementById('gallery-lb-img').alt = item.caption;
      document.getElementById('gallery-lb-caption').textContent = item.caption;
      document.getElementById('gallery-lb-counter').textContent = (galIdx + 1) + ' / ' + activeGalleryItems.length;
      document.getElementById('gallery-lb-prev').style.visibility = galIdx === 0 ? 'hidden' : 'visible';
      document.getElementById('gallery-lb-next').style.visibility = galIdx === activeGalleryItems.length - 1 ? 'hidden' : 'visible';
    }

    window.openGalleryLb = function(originalIndex) {
      var item = galleryItems[originalIndex];
      var idx = activeGalleryItems.indexOf(item);
      galIdx = idx !== -1 ? idx : 0;
      updateGalleryLb();
      var lb = document.getElementById('gallery-lightbox');
      lb.classList.remove('hidden');
      lb.classList.add('flex', 'flex-col');
      document.body.style.overflow = 'hidden';
    };

    window.galleryLbNav = function(dir) {
      var next = galIdx + dir;
      if (next >= 0 && next < activeGalleryItems.length) {
        galIdx = next;
        updateGalleryLb();
      }
    };

    window.closeGalleryLb = function() {
      var lb = document.getElementById('gallery-lightbox');
      lb.classList.add('hidden');
      lb.classList.remove('flex', 'flex-col');
      document.body.style.overflow = '';
    };

    document.addEventListener('keydown', function(e) {
      var lb = document.getElementById('gallery-lightbox');
      if (!lb || lb.classList.contains('hidden')) return;
      if (e.key === 'Escape') closeGalleryLb();
      if (e.key === 'ArrowLeft') galleryLbNav(-1);
      if (e.key === 'ArrowRight') galleryLbNav(1);
    });

    document.querySelectorAll('.imprint-filter').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var filter = this.getAttribute('data-filter');
        document.querySelectorAll('.imprint-filter').forEach(function(b) {
          b.classList.remove('bg-cream-900', 'text-white', 'border-cream-900');
          b.classList.add('border-cream-300', 'text-cream-700', 'hover:border-cream-700', 'hover:text-cream-900');
        });
        this.classList.remove('border-cream-300', 'text-cream-700', 'hover:border-cream-700', 'hover:text-cream-900');
        this.classList.add('bg-cream-900', 'text-white', 'border-cream-900');
        document.querySelectorAll('.imprint-card').forEach(function(card) {
          if (filter === 'all' || card.getAttribute('data-printer') === filter) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });
        activeGalleryItems = filter === 'all'
          ? galleryItems.slice()
          : galleryItems.filter(function(item) { return item.printer === filter; });
      });
    });
  </script>
</Base>
