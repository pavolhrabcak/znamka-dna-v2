---
import '../styles/global.css';
const { title = 'Britské kolónie', description = 'Encyklopédia gravírovaných poštových známok britského impéria.' } = Astro.props;
---
<!DOCTYPE html>
<html lang="sk">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} — Britské kolónie</title>
  <link rel="icon" type="image/png" href="/favicon.png" />
  <slot name="head" />
</head>
<body class="min-h-screen flex flex-col">

  <!-- Accent stripe -->
  <div class="h-[8px] bg-[#1e3a5f]"></div>

  <!-- Nav -->
  <nav class="bg-[#dce8f5] border-b border-[#b8cfe0] px-8 md:px-12 py-5">
    <div class="max-w-5xl mx-auto flex items-center justify-between">
      <a href="/" class="flex items-center gap-4 opacity-80 hover:opacity-100 transition-opacity pr-6 border-r border-[#a8c4dc]">
        <!-- Logo mark — Multiple Crown CA watermark -->
        <div class="flex-shrink-0 w-11 h-11 overflow-hidden"
             style="background-image:url('/stamps/watermark-logo.webp'); background-size:cover; background-position:center;"></div>
        <!-- Logo text -->
        <div class="flex flex-col leading-tight">
          <span class="font-serif text-lg tracking-wide text-[#0e1e2e]">Britské kolónie</span>
          <span class="text-[10px] tracking-widest uppercase text-[#2d5070] mt-0.5">v motívoch poštových známok</span>
        </div>
      </a>
      <ul class="hidden md:flex items-center gap-7 text-[13px] tracking-widest uppercase text-[#1e3a5f]">
        <li><a href="/territories" class="hover:text-stone-900 transition-colors">Teritóriá</a></li>
        <li><a href="/sety" class="hover:text-stone-900 transition-colors">Sety</a></li>
        <li><a href="/imprints" class="hover:text-stone-900 transition-colors">Imprinty</a></li>
        <li><a href="/ine-uzemia" class="hover:text-stone-900 transition-colors">Iné územia</a></li>
        <li class="relative group">
          <button type="button" class="flex items-center gap-1.5 hover:text-stone-900 transition-colors focus:outline-none">
            Panovníci
            <svg width="9" height="6" viewBox="0 0 9 6" fill="none" stroke="currentColor" stroke-width="1.5" class="opacity-50 group-hover:opacity-100 transition-opacity"><polyline points="0.5,0.5 4.5,5.5 8.5,0.5"/></svg>
          </button>
          <div class="invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-opacity duration-150 absolute top-full left-1/2 -translate-x-1/2 z-50 pt-2">
            <div class="bg-white border border-stone-200 shadow-lg py-1.5 min-w-[200px]">
              <a href="/era/kgv"  class="block px-4 py-1.5 text-[12px] tracking-widest uppercase text-stone-600 hover:text-stone-900 hover:bg-stone-50 transition-colors">KGV</a>
              <a href="/era/kgvi" class="block px-4 py-1.5 text-[12px] tracking-widest uppercase text-stone-600 hover:text-stone-900 hover:bg-stone-50 transition-colors">KGVI</a>
              <a href="/era/qeii" class="block px-4 py-1.5 text-[12px] tracking-widest uppercase text-stone-600 hover:text-stone-900 hover:bg-stone-50 transition-colors">QEII</a>
              <div class="border-t border-stone-100 my-1"></div>
              <a href="/omnibusy/1935-striebrone-jubileum" class="block px-4 py-1.5 text-[12px] tracking-widest uppercase text-stone-600 hover:text-stone-900 hover:bg-stone-50 transition-colors">1935 Strieborné jubileum</a>
              <a href="/omnibusy/1937-korunovacia"         class="block px-4 py-1.5 text-[12px] tracking-widest uppercase text-stone-600 hover:text-stone-900 hover:bg-stone-50 transition-colors">1937 Korunovácia</a>
            </div>
          </div>
        </li>
        <li class="relative group">
          <button type="button" class="flex items-center gap-1.5 hover:text-stone-900 transition-colors focus:outline-none">
            Tlačiarne
            <svg width="9" height="6" viewBox="0 0 9 6" fill="none" stroke="currentColor" stroke-width="1.5" class="opacity-50 group-hover:opacity-100 transition-opacity"><polyline points="0.5,0.5 4.5,5.5 8.5,0.5"/></svg>
          </button>
          <div class="invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-opacity duration-150 absolute top-full left-1/2 -translate-x-1/2 z-50 pt-2">
            <div class="bg-white border border-stone-200 shadow-lg py-1.5 min-w-[160px]">
              <a href="/printer/waterlow-and-sons"  class="block px-4 py-1.5 text-[12px] tracking-widest uppercase text-stone-600 hover:text-stone-900 hover:bg-stone-50 transition-colors">Waterlow &amp; Sons</a>
              <a href="/printer/de-la-rue"          class="block px-4 py-1.5 text-[12px] tracking-widest uppercase text-stone-600 hover:text-stone-900 hover:bg-stone-50 transition-colors">De La Rue</a>
              <a href="/printer/bradbury-wilkinson" class="block px-4 py-1.5 text-[12px] tracking-widest uppercase text-stone-600 hover:text-stone-900 hover:bg-stone-50 transition-colors">Bradbury Wilkinson</a>
              <div class="border-t border-stone-100 my-1"></div>
              <a href="/postup-tlace"         class="block px-4 py-1.5 text-[12px] tracking-widest uppercase text-stone-600 hover:text-stone-900 hover:bg-stone-50 transition-colors">Postup tlače</a>
              <a href="/tlaciarenske-vzorky"  class="block px-4 py-1.5 text-[12px] tracking-widest uppercase text-stone-600 hover:text-stone-900 hover:bg-stone-50 transition-colors">Tlačiarenské vzorky</a>
              <a href="/vzorkovnik-farieb"    class="block px-4 py-1.5 text-[12px] tracking-widest uppercase text-stone-600 hover:text-stone-900 hover:bg-stone-50 transition-colors">Vzorkovník farieb</a>
              <a href="/identifikacia-farieb" class="block px-4 py-1.5 text-[12px] tracking-widest uppercase text-stone-600 hover:text-stone-900 hover:bg-stone-50 transition-colors">Identifikácia farieb</a>
            </div>
          </div>
        </li>
        <li class="relative group">
          <button type="button" class="flex items-center gap-1.5 hover:text-stone-900 transition-colors focus:outline-none">
            Ďalšie
            <svg width="9" height="6" viewBox="0 0 9 6" fill="none" stroke="currentColor" stroke-width="1.5" class="opacity-50 group-hover:opacity-100 transition-opacity"><polyline points="0.5,0.5 4.5,5.5 8.5,0.5"/></svg>
          </button>
          <div class="invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-opacity duration-150 absolute top-full left-1/2 -translate-x-1/2 z-50 pt-2">
            <div class="bg-white border border-stone-200 shadow-lg py-1.5 min-w-[160px]">
              <a href="/glosar"          class="block px-4 py-1.5 text-[12px] tracking-widest uppercase text-stone-600 hover:text-stone-900 hover:bg-stone-50 transition-colors">Glosár</a>
              <a href="/essays"          class="block px-4 py-1.5 text-[12px] tracking-widest uppercase text-stone-600 hover:text-stone-900 hover:bg-stone-50 transition-colors">Essays</a>
              <a href="/falsne-peciatky" class="block px-4 py-1.5 text-[12px] tracking-widest uppercase text-stone-600 hover:text-stone-900 hover:bg-stone-50 transition-colors">Falošné pečiatky</a>
            </div>
          </div>
        </li>
      </ul>
      <div class="hidden md:flex items-center gap-5">
        <button onclick="openSearch()" aria-label="Hľadať" class="flex items-center gap-2 text-[#1e3a5f] hover:text-[#0a1828] transition-colors group">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="6.5" cy="6.5" r="5"/>
            <line x1="10.5" y1="10.5" x2="14" y2="14"/>
          </svg>
          <span id="search-shortcut" class="text-[10px] tracking-widest text-stone-400 group-hover:text-stone-600 transition-colors border border-stone-300 group-hover:border-stone-400 px-1.5 py-0.5">Ctrl+K</span>
        </button>
      </div>
    </div>
  </nav>

  <!-- Main -->
  <main class="flex-1">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="bg-[#dce8f5] border-t border-[#b8cfe0] mt-16 py-10 px-8">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4 text-[13px] tracking-widest uppercase text-[#1e3a5f]">
      <span>© {new Date().getFullYear()} Britské kolónie</span>
      <div class="flex gap-6">
        <a href="/territories" class="hover:text-stone-900 transition-colors">Teritóriá</a>
        <a href="/sety" class="hover:text-stone-900 transition-colors">Sety</a>
        <a href="/ine-uzemia" class="hover:text-stone-900 transition-colors">Iné územia</a>
        <a href="/era/kgv"  class="hover:text-stone-900 transition-colors">KGV</a>
        <a href="/era/kgvi" class="hover:text-stone-900 transition-colors">KGVI</a>
        <a href="/era/qeii" class="hover:text-stone-900 transition-colors">QEII</a>
        <a href="/zdroje" class="hover:text-stone-900 transition-colors">Zdroje</a>
      </div>
    </div>
  </footer>

  <!-- Pagefind -->
  <Fragment set:html={`
    <link rel="stylesheet" href="/pagefind/pagefind-ui.css">
    <script src="/pagefind/pagefind-ui.js"><\/script>
  `} />

  <!-- Scroll to top -->
  <button
    id="scroll-top-btn"
    aria-label="Späť hore"
    onclick="window.scrollTo({top:0,behavior:'smooth'})"
    class="hidden fixed bottom-6 right-6 z-40 w-10 h-10 bg-white border border-stone-300 text-stone-500 hover:border-stone-700 hover:text-stone-900 transition-colors items-center justify-center shadow-sm"
  >
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="1,10 7,3 13,10"/></svg>
  </button>

  <!-- Search modal -->
  <div
    id="search-modal"
    class="hidden fixed inset-0 bg-black/80 z-50 items-start justify-center pt-20 px-4"
    onclick="closeSearch()"
  >
    <div class="bg-white w-full max-w-2xl flex flex-col" style="max-height: 80vh" onclick="event.stopPropagation()">
      <div class="flex items-center justify-between px-5 py-3 border-b border-cream-200 flex-shrink-0">
        <span class="text-[10px] tracking-widest uppercase text-cream-400">Fulltext hľadanie</span>
        <button onclick="closeSearch()" class="text-cream-400 hover:text-cream-900 transition-colors text-xl leading-none px-1">&#215;</button>
      </div>
      <div id="search" class="p-5 overflow-y-auto"></div>
    </div>
  </div>

  <script is:inline>
    (function () {
      let initialized = false;

      window.openSearch = function () {
        const modal = document.getElementById('search-modal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';

        if (!initialized) {
          initialized = true;
          new PagefindUI({
            element: '#search',
            showSubResults: true,
            translations: {
              placeholder: 'Hľadať teritória, tlačiarne, éry…',
              zero_results: 'Žiadne výsledky pre "[SEARCH_TERM]"',
            },
          });
        }

        setTimeout(function () {
          document.querySelector('#search .pagefind-ui__search-input')?.focus();
        }, 50);
      };

      const shortcutEl = document.getElementById('search-shortcut');
      if (shortcutEl && /Mac|iPhone|iPad/.test(navigator.platform)) {
        shortcutEl.textContent = '⌘K';
      }

      window.closeSearch = function () {
        const modal = document.getElementById('search-modal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
      };

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeSearch();
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); openSearch(); }
      });

      var scrollBtn = document.getElementById('scroll-top-btn');
      if (scrollBtn) {
        window.addEventListener('scroll', function () {
          if (window.scrollY > 400) {
            scrollBtn.classList.remove('hidden');
            scrollBtn.classList.add('flex');
          } else {
            scrollBtn.classList.add('hidden');
            scrollBtn.classList.remove('flex');
          }
        }, { passive: true });
      }
    })();
  </script>

</body>
</html>
