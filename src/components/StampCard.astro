---
const { stamp } = Astro.props;
const { slug } = stamp;
const { title, country, denomination, year_issued, image } = stamp.data;
---

<article class="group flex flex-col">
  <a href={`/znamky/${slug}`} class="stamp-link flex flex-col h-full">
    <div class="stamp-img border border-cream-200 bg-white p-5 mb-3 overflow-hidden transition-all duration-200 group-hover:border-cream-500 group-hover:shadow-lg">
      <div class="aspect-[4/3] flex items-center justify-center">
        <img
          src={image}
          alt={title}
          class="w-full h-full object-contain transition-transform duration-300 group-hover:scale-[1.04]"
          loading="lazy"
        />
      </div>
    </div>
    <div class="stamp-text flex flex-col gap-0.5">
      <p class="text-[10px] tracking-widest uppercase text-cream-400">{country} · {year_issued}</p>
      <p class="stamp-title font-serif text-sm text-cream-800 leading-snug group-hover:text-cream-950 transition-colors line-clamp-2">{title}</p>
      <p class="stamp-denom hidden text-[10px] tracking-widest uppercase text-cream-400">{denomination}</p>
    </div>
  </a>
</article>
